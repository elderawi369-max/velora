{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "velora-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-03",
  "vars": {
    "APP_NAME": "Velora API",
    "APP_ENV": "production",
    "ENABLE_DEV_ENDPOINTS": "false",
    "AI_COMPANION_ENABLED": "false",
    "AI_COMPANION_VOICE_ENABLED": "false",
    "AI_COMPANION_CALLS_ENABLED": "false",
    "AI_COMPANION_DAILY_TRIAL_LIMIT": "40",
    "AI_COMPANION_BETA_EMAILS": ""
  },
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "COMPANION_AUDIO",
      "bucket_name": "velora-companion-audio"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "velora-prod",
      "database_id": "replace-with-your-cloudflare-d1-database-id",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
