{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "velora-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-02",
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		"APP_NAME": "Velora API",
		"APP_ENV": "production",
		"ENABLE_DEV_ENDPOINTS": "false",
		"GOOGLE_PLAY_PACKAGE_NAME": "com.velorachat.app",
		"PAYPAL_ENV": "live",
		"RESEND_FROM_EMAIL": "no-reply@velorachat.com",
		"RESEND_FROM_NAME": "Velora",
		"RESEND_SUPPORT_FROM_EMAIL": "support@velorachat.com",
		"SUPPORT_REPLY_TO_EMAIL": "support@velorachat.com",
		"AI_COMPANION_ENABLED": "false",
		"AI_COMPANION_VOICE_ENABLED": "true",
		"AI_COMPANION_CALLS_ENABLED": "true",
		"AI_COMPANION_DAILY_TRIAL_LIMIT": "40",
		"AI_COMPANION_BETA_EMAILS": ""
	},
	"ai": {
		"binding": "AI"
	},
	"r2_buckets": [
		{
			"binding": "COMPANION_IMAGES",
			"bucket_name": "velora-companion-images"
		},
		{
			"binding": "COMPANION_AUDIO",
			"bucket_name": "velora-companion-audio"
		}
	],
	"routes": [
		{
			"pattern": "api.velorachat.com",
			"zone_name": "velorachat.com",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "velora-prod",
			"database_id": "19155ba3-b108-40cc-93b3-f71d45279e8c",
			"preview_database_id": "velora-dev-local",
			"migrations_dir": "src/db/migrations"
		}
	],
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": ["0 16 * * *"]
	}
}
