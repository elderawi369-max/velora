+export const achievementCases = {
+  lighthouse: { title: "Lighthouse", number: "01", lines: ["Lighthouse"] },
+  "drowned-bell": { title: "The Drowned Bell", number: "02", lines: ["The Drowned Bell"] },
+  blackwood: { title: "Blackwood: The Last Exhibit", number: "03", lines: ["Blackwood:", "The Last Exhibit"] },
+} as const;
+
+export type AchievementCaseId = keyof typeof achievementCases;
+export const achievementRank = "Master Detective";
+export const achievementStoreLinks = {
+  googlePlay: "https://play.google.com/store/apps/details?id=com.velorachat.app",
+  appStore: "https://apps.apple.com/app/id6826858824",
+} as const;
+
+export function getAchievementCase(id: AchievementCaseId) {
+  if (!Object.prototype.hasOwnProperty.call(achievementCases, id)) throw new Error("Unknown investigation.");
+  return achievementCases[id];
+}
+
+export function achievementLinksText() {
+  return `Google Play: ${achievementStoreLinks.googlePlay}\nApp Store: ${achievementStoreLinks.appStore}`;
+}
+
+export function achievementShareText(id: AchievementCaseId) {
+  return `I solved ${getAchievementCase(id).title} in Velora!\n${achievementRank}\nCan you solve the mystery?\n\n${achievementLinksText()}`;
+}
+
+export function achievementFileName(id: AchievementCaseId) {
+  getAchievementCase(id);
+  return `velora-${id}-master-detective.png`;
+}
