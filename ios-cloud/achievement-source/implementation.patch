+import { useEffect, useState } from "react";
+import { Link } from "react-router-dom";
+import { createAchievementCard } from "../../lib/achievement-card";
+import { achievementLinksText, achievementRank, getAchievementCase, type AchievementCaseId } from "../../lib/achievement-data";
+import { saveAchievement, shareAchievement } from "../../lib/achievement-sharing";
+import "./investigation-achievement.css";
+
+export function InvestigationAchievement({ caseId }: { caseId: AchievementCaseId }) {
+  const [prepared, setPrepared] = useState<{ file: File; preview: string } | null>(null);
+  const [generation, setGeneration] = useState(0);
+  const [error, setError] = useState("");
+  const [status, setStatus] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [manualCopy, setManualCopy] = useState(false);
+  useEffect(() => {
+    let cancelled = false, preview = "";
+    setPrepared(null); setError(""); setStatus("");
+    void createAchievementCard(caseId).then(file => {
+      if (cancelled) return;
+      preview = URL.createObjectURL(file); setPrepared({ file, preview });
+    }).catch(() => { if (!cancelled) setError("Your card could not be prepared. Please try again."); });
+    return () => { cancelled = true; if (preview) URL.revokeObjectURL(preview); };
+  }, [caseId, generation]);
+
+  function exportCard(action: "share" | "save") {
+    if (!prepared || busy) return;
+    setBusy(true); setError(""); setStatus("");
+    const operation = action === "share" ? shareAchievement(prepared.file, caseId) : saveAchievement(prepared.file, caseId);
+    void operation.then(result => {
+      if (result.status === "saved") setStatus("Your achievement card was saved.");
+      if (result.status === "presented") setStatus(result.captionCopied ? "Your card is ready. Paste the copied caption to add both store links." : "Your card is ready. Use Copy store links, then paste them into your post.");
+      if (result.status === "downloaded") setStatus(result.captionCopied ? "Your card download started. Paste the copied caption to add both store links." : "Your card download started. Use Copy store links before posting.");
+      // Opening a destination is not proof that a social post was published.
+    }).catch(reason => setError(reason instanceof Error ? reason.message : "Sharing could not open. Please try again or save your card."))
+      .finally(() => setBusy(false));
+  }
+
+  function copyLinks() {
+    setStatus("");
+    if (!navigator.clipboard?.writeText) { setManualCopy(true); return; }
+    void navigator.clipboard.writeText(achievementLinksText()).then(() => { setStatus("Both store links copied."); setManualCopy(false); })
+      .catch(() => setManualCopy(true));
+  }
+
+  return <section className="investigation-achievement" aria-label="Your detective achievement">
+    {prepared ? <img className="investigation-achievement-preview" src={prepared.preview} alt={`Spoiler-free ${getAchievementCase(caseId).title} achievement card`} /> : <div className="investigation-achievement-seal" aria-hidden="true">✦</div>}
+    <div className="investigation-achievement-content">
+      <p className="investigation-achievement-kicker">CASE SOLVED!</p>
+      <h3>{achievementRank}</h3>
+      <p>Celebrate your investigation with a spoiler-free achievement card.</p>
+      <p id={`achievement-share-help-${caseId}`}>Your photo is shared separately. In Facebook or another app, paste the copied caption into your post to add both store links before posting.</p>
+      <div className="investigation-achievement-actions">
+        <button type="button" className="achievement-share-primary" aria-describedby={`achievement-share-help-${caseId}`} disabled={!prepared || busy} onClick={() => exportCard("share")}>{busy ? "Opening…" : prepared ? "Share Results" : "Preparing card…"}</button>
+        <Link className="achievement-play-next" to="/mind-hunters">Play Another Case</Link>
+      </div>
+      {prepared ? <div className="investigation-achievement-tools"><button type="button" disabled={busy} onClick={() => exportCard("save")}>Save card</button><button type="button" onClick={copyLinks}>Copy store links</button></div> : error ? <button type="button" className="achievement-retry" onClick={() => setGeneration(value => value + 1)}>Prepare card again</button> : null}
+      {manualCopy ? <label className="achievement-manual-copy">Store links<textarea readOnly value={achievementLinksText()} onFocus={event => event.currentTarget.select()} /></label> : null}
+      {status ? <p className="achievement-feedback" role="status">{status}</p> : null}
+      {error ? <p className="achievement-feedback" role="alert">{error}</p> : null}
+    </div>
+  </section>;
+}
