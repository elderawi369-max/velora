+import { achievementFileName, achievementRank, getAchievementCase, type AchievementCaseId } from "./achievement-data";
+
+const width = 1080;
+const height = 1350;
+let assets: Promise<HTMLImageElement[]> | undefined;
+
+function loadImage(src: string) {
+  return new Promise<HTMLImageElement>((resolve, reject) => {
+    const image = new Image();
+    image.onload = () => resolve(image);
+    image.onerror = () => reject(new Error("The achievement artwork could not load. Please try again."));
+    image.src = src;
+  });
+}
+
+function loadAssets() {
+  assets ??= Promise.all([
+    loadImage("/velora-favicon.svg"),
+    loadImage("/achievement-assets/app-store.svg"),
+    loadImage("/achievement-assets/google-play.png"),
+  ]).catch(error => { assets = undefined; throw error; });
+  return assets;
+}
+
+function rounded(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
+  ctx.beginPath(); ctx.moveTo(x + r, y); ctx.arcTo(x + w, y, x + w, y + h, r);
+  ctx.arcTo(x + w, y + h, x, y + h, r); ctx.arcTo(x, y + h, x, y, r);
+  ctx.arcTo(x, y, x + w, y, r); ctx.closePath();
+}
+
+function spaced(ctx: CanvasRenderingContext2D, text: string, y: number, spacing: number) {
+  const letters = [...text];
+  const total = letters.reduce((sum, letter) => sum + ctx.measureText(letter).width, 0) + (letters.length - 1) * spacing;
+  let x = (width - total) / 2;
+  ctx.textAlign = "left";
+  for (const letter of letters) { ctx.fillText(letter, x, y); x += ctx.measureText(letter).width + spacing; }
+  ctx.textAlign = "center";
+}
+
+function badge(ctx: CanvasRenderingContext2D, image: HTMLImageElement, x: number, y: number, w: number, h: number) {
+  const scale = Math.min(w / image.naturalWidth, h / image.naturalHeight);
+  const bw = image.naturalWidth * scale, bh = image.naturalHeight * scale;
+  ctx.drawImage(image, x + (w - bw) / 2, y + (h - bh) / 2, bw, bh);
+}
+
+/** A purpose-built card: no DOM capture, saved evidence, names, answers, or ending text. */
+export async function createAchievementCard(id: AchievementCaseId): Promise<File> {
+  const investigation = getAchievementCase(id);
+  const [logo, apple, google] = await loadAssets();
+  const canvas = document.createElement("canvas");
+  canvas.width = width; canvas.height = height;
+  const ctx = canvas.getContext("2d");
+  if (!ctx) throw new Error("This device could not prepare the achievement card.");
+  const background = ctx.createLinearGradient(0, 0, width, height);
+  background.addColorStop(0, "#182832"); background.addColorStop(0.5, "#0c151e"); background.addColorStop(1, "#171921");
+  ctx.fillStyle = background; ctx.fillRect(0, 0, width, height);
+  ctx.save(); ctx.strokeStyle = "#7693a0"; ctx.globalAlpha = 0.07; ctx.lineWidth = 1;
+  for (let line = -height; line < width; line += 44) { ctx.beginPath(); ctx.moveTo(line, 0); ctx.lineTo(line + height, height); ctx.stroke(); }
+  ctx.restore();
+  rounded(ctx, 36, 36, width - 72, height - 72, 24); ctx.strokeStyle = "#b99a62"; ctx.lineWidth = 2; ctx.stroke();
+  rounded(ctx, 51, 51, width - 102, height - 102, 15); ctx.strokeStyle = "#3b4244"; ctx.lineWidth = 1; ctx.stroke();
+  ctx.drawImage(logo, 88, 85, 100, 100);
+  ctx.textAlign = "left"; ctx.fillStyle = "#f8efe0"; ctx.font = "bold 74px Georgia, serif"; ctx.fillText("Velora", 212, 157);
+  ctx.fillStyle = "#bda77d"; ctx.font = "20px Arial, sans-serif"; ctx.fillText("MIND HUNTERS", 216, 191);
+  rounded(ctx, 753, 113, 226, 54, 10); ctx.fillStyle = "#1a2c37"; ctx.fill(); ctx.strokeStyle = "#526066"; ctx.stroke();
+  ctx.textAlign = "center"; ctx.fillStyle = "#d5c4a2"; ctx.font = "20px Arial, sans-serif"; ctx.fillText(`CASE FILE / ${investigation.number}`, 866, 148);
+  ctx.beginPath(); ctx.moveTo(92, 224); ctx.lineTo(988, 224); ctx.strokeStyle = "#4c514c"; ctx.stroke();
