+import { Capacitor, registerPlugin } from "@capacitor/core";
+import { achievementShareText, type AchievementCaseId } from "./achievement-data";
+
+export type AchievementExportResult = { status: "presented" | "saved" | "cancelled" | "downloaded"; captionCopied?: boolean };
+const nativeShare = registerPlugin<{
+  exportCard(options: { pngBase64: string; fileName: string; text: string; action: "share" | "save" }): Promise<AchievementExportResult>;
+}>("VeloraAchievementShare");
+
+function fileBase64(file: File) {
+  return new Promise<string>((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onerror = () => reject(new Error("The achievement image could not be read."));
+    reader.onload = () => {
+      const value = reader.result;
+      if (typeof value !== "string" || !value.startsWith("data:image/png;base64,")) reject(new Error("The achievement image is invalid."));
+      else resolve(value.slice(value.indexOf(",") + 1));
+    };
+    reader.readAsDataURL(file);
+  });
+}
+
+function exportNative(file: File, id: AchievementCaseId, action: "share" | "save") {
+  if (!Capacitor.isPluginAvailable("VeloraAchievementShare")) return Promise.reject(new Error("Please update Velora to share or save this achievement."));
+  return fileBase64(file).then(pngBase64 => nativeShare.exportCard({ pngBase64, fileName: file.name, text: achievementShareText(id), action }));
+}
+
+function downloadCard(file: File): AchievementExportResult {
+  const url = URL.createObjectURL(file);
+  const anchor = document.createElement("a");
+  anchor.href = url; anchor.download = file.name; document.body.appendChild(anchor); anchor.click(); anchor.remove();
+  window.setTimeout(() => URL.revokeObjectURL(url), 30000);
+  return { status: "downloaded" };
+}
+
+async function copyCaption(text: string) {
+  try {
+    if (!navigator.clipboard?.writeText) return false;
+    await navigator.clipboard.writeText(text);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+// The prepared File lets Web Share run directly inside the button's user gesture.
+export function shareAchievement(file: File, id: AchievementCaseId): Promise<AchievementExportResult> {
+  const text = achievementShareText(id);
+  if (Capacitor.isNativePlatform()) return exportNative(file, id, "share");
+  let supportsFiles = false;
+  try { supportsFiles = typeof navigator.share === "function" && Boolean(navigator.canShare?.({ files: [file] })); } catch { /* Download fallback. */ }
+  if (!supportsFiles) return copyCaption(text).then(captionCopied => ({ ...downloadCard(file), captionCopied }));
+  try {
+    // Invoke Web Share synchronously inside the click's user activation. Copying
+    // runs alongside it; awaiting clipboard first can make Safari reject share().
+    const copied = copyCaption(text);
+    const shared = navigator.share({ files: [file], title: "Velora · Master Detective" });
+    return shared.then(
+      async () => ({ status: "presented" as const, captionCopied: await copied }),
+      async error => { const captionCopied = await copied; if (error?.name === "AbortError") return { status: "cancelled" as const, captionCopied }; throw error; },
+    );
+  } catch (error) { return Promise.reject(error); }
+}
+
+export function saveAchievement(file: File, id: AchievementCaseId): Promise<AchievementExportResult> {
+  return Capacitor.isNativePlatform() ? exportNative(file, id, "save") : Promise.resolve(downloadCard(file));
+}
