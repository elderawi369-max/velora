@@ -0,0 +1,45 @@
+import { useEffect, useState } from "react";
+import { useQueryClient } from "@tanstack/react-query";
+import { AppleStoreKit, deliverAppleTransaction, isNativeAppleApp, recoverApplePurchases } from "../../lib/apple-billing";
+import { Capacitor } from "@capacitor/core";
+
+export function ApplePurchaseRecovery({ userId }: { userId?: string }) {
+  const [error, setError] = useState("");
+  const [retrying, setRetrying] = useState(false);
+  const queryClient = useQueryClient();
+  async function retry() {
+    if (!userId) return;
+    setRetrying(true);
+    try { await recoverApplePurchases(); setError(""); }
+    catch (e) { setError(e instanceof Error ? e.message : "Purchase delivery needs another attempt."); }
+    finally { setRetrying(false); }
+  }
+  useEffect(() => {
+    setError("");
+    if (!userId || !isNativeAppleApp() || !Capacitor.isPluginAvailable("VeloraStoreKit")) return;
+    let disposed = false;
+    let listener: { remove(): Promise<void> } | undefined;
+    const capture = (e: unknown) => { if (!disposed) setError(e instanceof Error ? e.message : "Purchase delivery needs another attempt."); };
+    const recover = () => { void recoverApplePurchases().then(() => { if (!disposed) setError(""); }).catch(capture); };
+    const refresh = () => {
+      if (disposed) return;
+      setError("");
+      for (const key of ["ownProfile", "profiles", "notifications", "challenges", "conversation"]) void queryClient.invalidateQueries({ queryKey: [key] });
+    };
+    void AppleStoreKit.addListener("transactionUpdated", transaction => { void deliverAppleTransaction(transaction).catch(capture); }).then(handle => { if (disposed) void handle.remove(); else listener = handle; }).catch(capture);
+    const visible = () => { if (document.visibilityState === "visible") recover(); };
+    document.addEventListener("visibilitychange", visible);
+    window.addEventListener("velora-apple-purchase-delivered", refresh);
+    window.addEventListener("velora-apple-purchase-needs-delivery", recover);
+    recover();
+    return () => {
+      disposed = true;
+      void listener?.remove();
+      document.removeEventListener("visibilitychange", visible);
+      window.removeEventListener("velora-apple-purchase-delivered", refresh);
+      window.removeEventListener("velora-apple-purchase-needs-delivery", recover);
+    };
+  }, [userId, queryClient]);
+  if (!userId || !isNativeAppleApp() || !error) return null;
+  return <aside className="panel" role="status"><p>{error}</p><button className="secondary-button" disabled={retrying} onClick={() => { void retry(); }}>{retrying ? "Delivering purchase…" : "Retry purchase delivery"}</button></aside>;
+}
