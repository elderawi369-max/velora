+import { useQuery } from "@tanstack/react-query";
+import { appleProductIds, fetchAppleProducts, isNativeAppleApp } from "../../lib/apple-billing";
+
+export function useAppleProductPrices() {
+  const ios = isNativeAppleApp();
+  const query = useQuery({ queryKey: ["appleProducts"], queryFn: fetchAppleProducts, enabled: ios, staleTime: 5 * 60 * 1000, retry: 1 });
+  return {
+    ios,
+    price(itemKey: string, cents: number) {
+      if (!ios) return `$${(cents / 100).toFixed(2)}`;
+      return query.data?.products?.find(p => p.productId === appleProductIds[itemKey])?.displayPrice ?? (query.isLoading ? "Loading price…" : "Unavailable");
+    },
+    canBuy(itemKey: string) { return !ios || Boolean(query.data?.canMakePayments && query.data.products?.some(p => p.productId === appleProductIds[itemKey])); },
+    notice: ios ? <><p className="status-message">{query.error ? "Apple purchases are not available right now." : query.data && !query.data.products?.length ? "These products are not available in the App Store yet." : query.data && !query.data.canMakePayments ? "Purchases are disabled on this device." : "Purchases are processed securely by the App Store."}</p>{query.error ? <button className="secondary-button" onClick={() => { void query.refetch(); }}>Reload prices</button> : null}</> : null,
+  };
+}
