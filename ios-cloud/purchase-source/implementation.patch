+import { cleanup, render, screen } from "@testing-library/react";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("@capacitor/core", () => ({
+  Capacitor: { getPlatform: () => "ios", isNativePlatform: () => true, isPluginAvailable: () => true },
+  registerPlugin: () => ({ queryProducts: async () => ({ canMakePayments: true, products: [
+    { productId: "com.velorachat.app.gift.rose_aura", displayPrice: "EGP 49.99", displayName: "Rose Aura" },
+  ] }) }),
+}));
+vi.mock("../../lib/api", () => ({
+  fetchGiftCatalog: async () => ({ gifts: [
+    { key: "rose", label: "Rose Aura", priceCents: 99 }, { key: "crown", label: "Velora Crown", priceCents: 249 },
+  ] }),
+  fetchAppleBillingConfig: async () => ({ available: true }),
+}));
+import { GiftActions } from "./gift-actions";
+afterEach(cleanup);
+describe("Apple purchase buttons", () => {
+  it("uses the App Store's localized price and disables products Apple has not returned", async () => {
+    const client = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+    render(<QueryClientProvider client={client}><GiftActions profileId="recipient" /></QueryClientProvider>);
+    const available = await screen.findByRole("button", { name: "Send Rose Aura · EGP 49.99" });
+    expect((available as HTMLButtonElement).disabled).toBe(false);
+    const missing = await screen.findByRole("button", { name: "Send Velora Crown · Unavailable" });
+    expect((missing as HTMLButtonElement).disabled).toBe(true);
+    expect(screen.queryByRole("button", { name: /\$0\.99/ })).toBeNull();
+    client.clear();
+  });
+});
