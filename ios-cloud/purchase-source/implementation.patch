+    CREATE TABLE gifts(id TEXT PRIMARY KEY,sender_profile_id TEXT,target_profile_id TEXT,gift_type TEXT,created_at INTEGER);
+    CREATE TABLE boosts(id TEXT PRIMARY KEY,profile_id TEXT,boost_type TEXT,created_at INTEGER,expires_at INTEGER);
