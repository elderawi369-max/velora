+import { Hono } from "hono";
+import { z } from "zod";
+import type { EnvBindings } from "../lib/db";
+import { getOwnProfileContext } from "../lib/profile-context";
+import { appleBillingConfigured, appleProducts, ApplePurchaseError, fetchAppleTransaction, validateAppleTransaction } from "../lib/apple-purchases";
+import { createNotification } from "../lib/commerce";
+
+export const applePurchaseRoutes = new Hono<{ Bindings: EnvBindings }>();
+const intentSchema = z.object({ productId: z.string().max(160), targetProfileId: z.string().max(100).optional() }).strict();
+const verifySchema = z.object({ transactionId: z.string().regex(/^\d{1,40}$/), intentId: z.string().uuid() }).strict();
+type Intent = { id: string; user_id: string; buyer_profile_id: string; target_profile_id: string | null; product_id: string; product_kind: string; item_key: string; transaction_id: string | null; created_at: number; fulfilled_at: number | null };
+
+applePurchaseRoutes.onError((error, c) => {
+  if (error instanceof ApplePurchaseError) return c.json({ error: error.message }, error.status as 400 | 403 | 404 | 409 | 502 | 503);
+  // Do not expose Apple API responses, authentication material, or database details.
+  return c.json({ error: "Purchase delivery could not finish. Please retry; you will not be charged again." }, 503);
+});
+
+applePurchaseRoutes.get("/config", c => c.json({ available: appleBillingConfigured(c.env), products: appleProducts.map(({ productId, productKind, itemKey }) => ({ productId, productKind, itemKey })) }));
+
+applePurchaseRoutes.post("/intents", async c => {
+  const own = await getOwnProfileContext(c.env, c.req.header("Cookie"), c.req.header("Authorization"));
+  if (!own) return c.json({ error: "Sign in and create a public profile before purchasing." }, 401);
+  if (!appleBillingConfigured(c.env)) throw new ApplePurchaseError("Apple purchases are not available yet. Please try again later.", 503);
+  const parsed = intentSchema.safeParse(await c.req.json());
+  if (!parsed.success) throw new ApplePurchaseError("Invalid purchase request.");
+  const item = appleProducts.find(p => p.productId === parsed.data.productId);
+  if (!item) throw new ApplePurchaseError("This product is not available.");
+  const target = item.productKind === "gift" ? parsed.data.targetProfileId : null;
+  if (item.productKind === "gift") {
+    if (!target || target === own.profileId) throw new ApplePurchaseError("Choose another profile to receive this gift.");
+    const allowed = await c.env.DB.prepare("SELECT id FROM profiles WHERE id = ? AND suspended_at IS NULL AND NOT EXISTS (SELECT 1 FROM blocks WHERE (profile_id = ? AND target_profile_id = ?) OR (profile_id = ? AND target_profile_id = ?))")
+      .bind(target, own.profileId, target, target, own.profileId).first();
+    if (!allowed) throw new ApplePurchaseError("This profile cannot receive a gift.");
+  } else if (parsed.data.targetProfileId) throw new ApplePurchaseError("This product is for your own profile.");
+  const id = crypto.randomUUID();
+  await c.env.DB.prepare("INSERT INTO apple_purchase_intents (id,user_id,buyer_profile_id,target_profile_id,product_id,product_kind,item_key,created_at) VALUES (?,?,?,?,?,?,?,?)")
+    .bind(id, own.userId, own.profileId, target ?? null, item.productId, item.productKind, item.itemKey, Date.now()).run();
+  return c.json({ intentId: id, productId: item.productId }, 201);
+});
+
+applePurchaseRoutes.post("/verify", async c => {
+  const own = await getOwnProfileContext(c.env, c.req.header("Cookie"), c.req.header("Authorization"));
+  if (!own) return c.json({ error: "Sign in to deliver your purchase." }, 401);
+  const parsed = verifySchema.safeParse(await c.req.json());
+  if (!parsed.success) throw new ApplePurchaseError("Invalid purchase verification request.");
+  const { transactionId, intentId } = parsed.data;
+  const intent = await c.env.DB.prepare("SELECT * FROM apple_purchase_intents WHERE id = ? AND user_id = ? AND buyer_profile_id = ?")
+    .bind(intentId.toLowerCase(), own.userId, own.profileId).first<Intent>();
+  if (!intent) throw new ApplePurchaseError("This purchase belongs to a different Velora account. Sign in to the account used to buy it.", 403);
+  if (intent.transaction_id && intent.transaction_id !== transactionId) throw new ApplePurchaseError("This purchase request has already been completed.", 409);
+  const purchaseId = `apple-${transactionId}`;
+  if (intent.fulfilled_at && intent.transaction_id === transactionId) return c.json({ ok: true, purchaseId, delivered: true });
+  const item = appleProducts.find(p => p.productId === intent.product_id);
+  if (!item) throw new ApplePurchaseError("Unknown purchase product.");
+  const { transaction, environment } = await fetchAppleTransaction(c.env, transactionId);
+  validateAppleTransaction(transaction, { transactionId, bundleId: c.env.APPLE_BUNDLE_ID!, productId: item.productId, intentId, createdAt: intent.created_at, environment });
+  if (item.productKind === "gift" && !intent.target_profile_id) throw new ApplePurchaseError("The gift recipient is no longer available. Please contact support.", 409);
+  const now = Date.now();
+  const gate = "EXISTS (SELECT 1 FROM purchases WHERE id = ? AND status = 'pending')";
+  const statements: D1PreparedStatement[] = [
+    c.env.DB.prepare("UPDATE apple_purchase_intents SET transaction_id = ? WHERE id = ? AND transaction_id IS NULL").bind(transactionId, intent.id),
+    c.env.DB.prepare("INSERT OR IGNORE INTO purchases (id,stripe_session_id,buyer_profile_id,target_profile_id,mobile_provider,mobile_product_id,mobile_order_id,mobile_package_name,mobile_verified_at,product_kind,item_key,amount_cents,currency,status,created_at) SELECT ?,?,?,?,?,?,?,?,?,?,?,?,?,?,? FROM apple_purchase_intents WHERE id = ? AND transaction_id = ?")
+      .bind(purchaseId, `apple:${transactionId}`, own.profileId, intent.target_profile_id, "apple", item.productId, transactionId, c.env.APPLE_BUNDLE_ID!, now, item.productKind, item.itemKey,
+        typeof transaction.price === "number" ? Math.round(transaction.price / 10) : item.priceCents, transaction.currency?.toLowerCase() ?? "usd", "pending", now, intent.id, transactionId),
+  ];
+  if (item.productKind === "gift") statements.push(c.env.DB.prepare(`INSERT OR IGNORE INTO gifts (id,sender_profile_id,target_profile_id,gift_type,created_at) SELECT ?,?,?,?,? WHERE ${gate}`)
+    .bind(`apple-gift-${transactionId}`, own.profileId, intent.target_profile_id, item.itemKey, now, purchaseId));
+  if (item.productKind === "boost") statements.push(c.env.DB.prepare(`INSERT OR IGNORE INTO boosts (id,profile_id,boost_type,created_at,expires_at) SELECT ?,?,?,?,? WHERE ${gate}`)
+    .bind(`apple-boost-${transactionId}`, own.profileId, item.itemKey, now, now + (item.itemKey === "spark" ? 6 : 24) * 3600000, purchaseId));
+  if (item.productKind === "challenge_credit_pack") statements.push(c.env.DB.prepare(`UPDATE profiles SET challenge_credits = challenge_credits + ?, updated_at = ? WHERE id = ? AND ${gate}`)
+    .bind(item.itemKey === "challenge_pack_3" ? 3 : 10, now, own.profileId, purchaseId));
+  statements.push(c.env.DB.prepare("UPDATE purchases SET status = 'fulfilled', fulfilled_at = ? WHERE id = ? AND status = 'pending'").bind(now, purchaseId));
+  statements.push(c.env.DB.prepare("UPDATE apple_purchase_intents SET fulfilled_at = ? WHERE id = ? AND transaction_id = ? AND EXISTS (SELECT 1 FROM purchases WHERE id = ? AND status = 'fulfilled')").bind(now, intent.id, transactionId, purchaseId));
+  // D1 batch is an atomic transaction: concurrent retries cannot duplicate credit,
+  // boost, or gift delivery, and a failure rolls back the entire fulfillment.
+  const results = await c.env.DB.batch(statements);
+  const confirmed = await c.env.DB.prepare("SELECT fulfilled_at FROM apple_purchase_intents WHERE id = ? AND transaction_id = ?").bind(intent.id, transactionId).first<{ fulfilled_at: number | null }>();
+  if (!confirmed?.fulfilled_at) throw new ApplePurchaseError("Purchase delivery is pending. Please retry delivery.", 409);
+  if (item.productKind === "gift" && results[1].meta.changes > 0) {
+    await createNotification(c.env, { profileId: intent.target_profile_id!, actorProfileId: own.profileId, type: "gift", giftType: item.itemKey }).catch(() => undefined);
+  }
+  return c.json({ ok: true, purchaseId, delivered: true });
+});
