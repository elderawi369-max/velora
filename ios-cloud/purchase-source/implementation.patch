+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const mocks = vi.hoisted(() => ({
+  native: { queryProducts: vi.fn(), purchaseProduct: vi.fn(), unfinishedTransactions: vi.fn(), finishTransaction: vi.fn() },
+  create: vi.fn(), verify: vi.fn(), config: vi.fn(),
+}));
+vi.mock("@capacitor/core", () => ({ Capacitor: { getPlatform: () => "ios", isNativePlatform: () => true, isPluginAvailable: () => true }, registerPlugin: () => mocks.native }));
+vi.mock("./api", () => ({ createApplePurchaseIntent: mocks.create, verifyApplePurchaseDelivery: mocks.verify, fetchAppleBillingConfig: mocks.config }));
+import { appleProductIds, completeApplePurchase, deliverAppleTransaction, fetchAppleProducts, recoverApplePurchases } from "./apple-billing";
+
+const intentId = "05743e3e-dbe3-400c-b58d-c6c89a5754a6";
+const transaction = { transactionId: "123456", productId: appleProductIds.rose, appAccountToken: intentId };
+beforeEach(() => {
+  vi.resetAllMocks();
+  mocks.native.unfinishedTransactions.mockResolvedValue({ transactions: [] });
+  mocks.native.finishTransaction.mockResolvedValue({ finished: true });
+  mocks.create.mockResolvedValue({ intentId, productId: appleProductIds.rose });
+  mocks.verify.mockResolvedValue({ ok: true, delivered: true });
+});
+
+describe("Apple purchase safety and recovery", () => {
+  it("does not finish or grant cancelled and pending purchases", async () => {
+    mocks.native.purchaseProduct.mockResolvedValueOnce({ status: "cancelled" });
+    expect(await completeApplePurchase({ itemKey: "rose", targetProfileId: "recipient" })).toEqual({ cancelled: true });
+    mocks.native.purchaseProduct.mockResolvedValueOnce({ status: "pending" });
+    await expect(completeApplePurchase({ itemKey: "rose" })).rejects.toThrow("pending Apple approval");
+    expect(mocks.verify).not.toHaveBeenCalled(); expect(mocks.native.finishTransaction).not.toHaveBeenCalled();
+  });
+  it("never presents payment when the server rejects preflight", async () => {
+    mocks.create.mockRejectedValue(new Error("Purchases are not available"));
+    await expect(completeApplePurchase({ itemKey: "rose" })).rejects.toThrow("not available");
+    expect(mocks.native.purchaseProduct).not.toHaveBeenCalled();
+  });
+  it("binds the recipient before payment and finishes only after confirmed server delivery", async () => {
+    const order: string[] = [];
+    mocks.native.purchaseProduct.mockResolvedValue({ status: "purchased", transaction });
+    mocks.verify.mockImplementation(async () => { order.push("delivered"); return { ok: true, delivered: true }; });
+    mocks.native.finishTransaction.mockImplementation(async () => { order.push("finished"); return { finished: true }; });
+    expect(await completeApplePurchase({ itemKey: "rose", targetProfileId: "recipient" })).toEqual({ cancelled: false });
+    expect(mocks.create).toHaveBeenCalledWith({ productId: appleProductIds.rose, targetProfileId: "recipient" });
+    expect(mocks.native.purchaseProduct).toHaveBeenCalledWith({ productId: appleProductIds.rose, appAccountToken: intentId });
+    expect(order).toEqual(["delivered", "finished"]);
+  });
+  it("leaves paid transactions unfinished after an API failure and recovers without another charge", async () => {
+    mocks.native.purchaseProduct.mockResolvedValue({ status: "purchased", transaction });
+    mocks.verify.mockRejectedValueOnce(new Error("network unavailable"));
+    await expect(completeApplePurchase({ itemKey: "rose" })).rejects.toThrow("will not be charged again");
+    expect(mocks.native.finishTransaction).not.toHaveBeenCalled();
+    mocks.native.unfinishedTransactions.mockResolvedValue({ transactions: [transaction] });
+    await recoverApplePurchases();
+    expect(mocks.native.purchaseProduct).toHaveBeenCalledTimes(1);
+    expect(mocks.native.finishTransaction).toHaveBeenCalledWith({ transactionId: "123456" });
+  });
+  it("does not deliver a transaction bound to another intent", async () => {
+    mocks.native.purchaseProduct.mockResolvedValue({ status: "purchased", transaction: { ...transaction, appAccountToken: "another-token" } });
+    await expect(completeApplePurchase({ itemKey: "rose" })).rejects.toThrow("awaiting verification");
+    expect(mocks.verify).not.toHaveBeenCalled(); expect(mocks.native.finishTransaction).not.toHaveBeenCalled();
+  });
+  it("coalesces duplicate native callbacks for the same transaction", async () => {
+    await Promise.all([deliverAppleTransaction(transaction), deliverAppleTransaction(transaction)]);
+    expect(mocks.verify).toHaveBeenCalledTimes(1); expect(mocks.native.finishTransaction).toHaveBeenCalledTimes(1);
+  });
+  it("returns Apple's localized prices without a hard-coded dollar fallback", async () => {
+    mocks.config.mockResolvedValue({ available: true });
+    mocks.native.queryProducts.mockResolvedValue({ canMakePayments: true, products: [{ productId: appleProductIds.rose, displayPrice: "EGP 49.99" }] });
+    expect((await fetchAppleProducts()).products[0].displayPrice).toBe("EGP 49.99");
+  });
+});
