+}
+
+function transaction(intent: { intentId: string; productId: string }, patch: Partial<AppleTransaction> = {}): AppleTransaction {
+  return { transactionId: "123456", originalTransactionId: "123456", bundleId: credentials.APPLE_BUNDLE_ID, productId: intent.productId,
+    appAccountToken: intent.intentId, environment: "Production", type: "Consumable", quantity: 1, purchaseDate: Date.now(), price: 990, currency: "USD", ...patch };
+}
