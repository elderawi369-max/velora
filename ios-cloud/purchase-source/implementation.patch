@@ -0,0 +1,81 @@
+import { Capacitor, registerPlugin } from "@capacitor/core";
+import { createApplePurchaseIntent, fetchAppleBillingConfig, verifyApplePurchaseDelivery } from "./api";
+
+export const appleProductIds: Record<string, string> = {
+  rose: "com.velorachat.app.gift.rose_aura", starlight: "com.velorachat.app.gift.starlight_ring",
+  crown: "com.velorachat.app.gift.velora_crown", spark: "com.velorachat.app.boost.spark",
+  spotlight: "com.velorachat.app.boost.spotlight", challenge_pack_3: "com.velorachat.app.credits.3",
+  challenge_pack_10: "com.velorachat.app.credits.10",
+};
+export type AppleProduct = { productId: string; displayName: string; description: string; displayPrice: string };
+export type ApplePurchaseTransaction = { transactionId: string; productId: string; appAccountToken: string };
+type AppleNative = {
+  queryProducts(options: { productIds: string[] }): Promise<{ products: AppleProduct[]; canMakePayments: boolean }>;
+  purchaseProduct(options: { productId: string; appAccountToken: string }): Promise<{ status: "cancelled" | "pending" | "purchased"; transaction?: ApplePurchaseTransaction }>;
+  unfinishedTransactions(): Promise<{ transactions: ApplePurchaseTransaction[] }>;
+  finishTransaction(options: { transactionId: string }): Promise<{ finished: boolean }>;
+  addListener(name: "transactionUpdated", listener: (transaction: ApplePurchaseTransaction) => void): Promise<{ remove(): Promise<void> }>;
+};
+export const AppleStoreKit = registerPlugin<AppleNative>("VeloraStoreKit");
+export function isNativeAppleApp() { return Capacitor.getPlatform() === "ios" && Capacitor.isNativePlatform(); }
+
+export async function fetchAppleProducts() {
+  if (!isNativeAppleApp()) return { products: [] as AppleProduct[], canMakePayments: false };
+  if (!Capacitor.isPluginAvailable("VeloraStoreKit")) throw new Error("Apple purchases require the latest Velora app update.");
+  const config = await fetchAppleBillingConfig();
+  if (!config.available) throw new Error("Apple purchases are not available yet.");
+  return AppleStoreKit.queryProducts({ productIds: Object.values(appleProductIds) });
+}
+
+const deliveries = new Map<string, Promise<void>>();
+export function deliverAppleTransaction(transaction: ApplePurchaseTransaction): Promise<void> {
+  const running = deliveries.get(transaction.transactionId);
+  if (running) return running;
+  const delivery = (async () => {
+    if (!transaction.appAccountToken || !Object.values(appleProductIds).includes(transaction.productId)) throw new Error("This Apple purchase needs assistance from support.");
+    const result = await verifyApplePurchaseDelivery({ transactionId: transaction.transactionId, intentId: transaction.appAccountToken });
+    if (!result.ok || !result.delivered) throw new Error("Your purchase is awaiting delivery. Please retry; you will not be charged again.");
+    // A failed delivery must remain unfinished so StoreKit can recover it later.
+    await AppleStoreKit.finishTransaction({ transactionId: transaction.transactionId });
+    window.dispatchEvent(new Event("velora-apple-purchase-delivered"));
+  })().finally(() => { deliveries.delete(transaction.transactionId); });
+  deliveries.set(transaction.transactionId, delivery);
+  return delivery;
+}
+
+export async function recoverApplePurchases() {
+  if (!isNativeAppleApp() || !Capacitor.isPluginAvailable("VeloraStoreKit")) return;
+  const { transactions } = await AppleStoreKit.unfinishedTransactions();
+  let failure: unknown;
+  for (const transaction of transactions) {
+    try { await deliverAppleTransaction(transaction); } catch (error) { failure ??= error; }
+  }
+  if (failure) throw failure;
+}
+
+let purchaseInProgress = false;
+export async function completeApplePurchase(input: { itemKey: string; targetProfileId?: string }) {
+  if (!isNativeAppleApp() || !Capacitor.isPluginAvailable("VeloraStoreKit")) throw new Error("Apple purchases are unavailable in this app build.");
+  if (purchaseInProgress) throw new Error("Another purchase is already in progress.");
+  const productId = appleProductIds[input.itemKey];
+  if (!productId) throw new Error("Unknown purchase product.");
+  purchaseInProgress = true;
+  try {
+    await recoverApplePurchases();
+    // Creating a server intent verifies sign-in, recipient, and server readiness
+    // before presenting any payment sheet. Its UUID binds Apple's transaction
+    // to the original account, item, and gift recipient across app restarts.
+    const intent = await createApplePurchaseIntent({ productId, targetProfileId: input.targetProfileId });
+    if (intent.productId !== productId) throw new Error("The purchase product could not be confirmed.");
+    const result = await AppleStoreKit.purchaseProduct({ productId, appAccountToken: intent.intentId });
+    if (result.status === "cancelled") return { cancelled: true as const };
+    if (result.status === "pending") throw new Error("Purchase pending Apple approval. It will be delivered automatically after approval.");
+    if (!result.transaction || result.transaction.productId !== productId || result.transaction.appAccountToken.toLowerCase() !== intent.intentId.toLowerCase()) throw new Error("The purchase is awaiting verification. Please use Retry purchase delivery.");
+    try { await deliverAppleTransaction(result.transaction); }
+    catch {
+      window.dispatchEvent(new Event("velora-apple-purchase-needs-delivery"));
+      throw new Error("Your purchase was paid, but delivery could not finish. Use Retry purchase delivery; you will not be charged again.");
+    }
+    return { cancelled: false as const };
+  } finally { purchaseInProgress = false; }
+}
