+  sqlite.exec(readFileSync(new URL("../db/migrations/0051_add_apple_purchase_intents.sql", import.meta.url), "utf8"));
+  function statement(query: string, params: (string | number | null)[] = []) {
+    return { query, params,
+      bind: (...values: (string | number | null)[]) => statement(query, values),
+      async raw() { const s = sqlite.prepare(query); s.setReturnArrays(true); return s.all(...params); },
+      async first() { return sqlite.prepare(query).get(...params) ?? null; },
+      async all() { return { results: sqlite.prepare(query).all(...params) }; },
+      async run() { return { meta: sqlite.prepare(query).run(...params) }; },
+    };
+  }
+  const env = { ...credentials, DB: { prepare: statement,
+    async batch(items: { query: string; params: (string | number | null)[] }[]) {
+      sqlite.exec("BEGIN");
+      try { const results = items.map(s => ({ meta: sqlite.prepare(s.query).run(...s.params) })); sqlite.exec("COMMIT"); return results; }
+      catch (e) { sqlite.exec("ROLLBACK"); throw e; }
