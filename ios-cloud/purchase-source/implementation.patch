+import type { EnvBindings } from "./db";
+
+export const appleProducts = [
+  { productId: "com.velorachat.app.gift.rose_aura", productKind: "gift", itemKey: "rose", label: "Rose Aura", priceCents: 99 },
+  { productId: "com.velorachat.app.gift.starlight_ring", productKind: "gift", itemKey: "starlight", label: "Starlight Ring", priceCents: 149 },
+  { productId: "com.velorachat.app.gift.velora_crown", productKind: "gift", itemKey: "crown", label: "Velora Crown", priceCents: 249 },
+  { productId: "com.velorachat.app.boost.spark", productKind: "boost", itemKey: "spark", label: "Spark Boost", priceCents: 149 },
+  { productId: "com.velorachat.app.boost.spotlight", productKind: "boost", itemKey: "spotlight", label: "Spotlight Boost", priceCents: 299 },
+  { productId: "com.velorachat.app.credits.3", productKind: "challenge_credit_pack", itemKey: "challenge_pack_3", label: "3 Challenge Credits", priceCents: 99 },
+  { productId: "com.velorachat.app.credits.10", productKind: "challenge_credit_pack", itemKey: "challenge_pack_10", label: "10 Challenge Credits", priceCents: 249 },
+] as const;
+
+export class ApplePurchaseError extends Error {
+  constructor(message: string, public status = 400) { super(message); }
+}
+
+export type AppleTransaction = {
+  transactionId: string; originalTransactionId: string; bundleId: string;
+  productId: string; appAccountToken: string; environment: "Production" | "Sandbox";
+  type: string; quantity: number; purchaseDate: number; revocationDate?: number;
+  inAppOwnershipType?: string; price?: number; currency?: string;
+};
+
+export function appleBillingConfigured(env: EnvBindings) {
+  return Boolean(env.APPLE_IAP_ISSUER_ID && env.APPLE_IAP_KEY_ID && env.APPLE_IAP_PRIVATE_KEY && env.APPLE_BUNDLE_ID);
+}
+
+function encode(bytes: Uint8Array) {
+  return btoa(String.fromCharCode(...bytes)).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+}
+function json64(value: unknown) { return encode(new TextEncoder().encode(JSON.stringify(value))); }
+
+export async function appleServerToken(env: EnvBindings) {
+  if (!appleBillingConfigured(env)) throw new ApplePurchaseError("Apple purchases are not available yet. Please try again later.", 503);
+  const pem = env.APPLE_IAP_PRIVATE_KEY!.replace(/\\n/g, "\n").replace(/-----[A-Z ]+-----/g, "").replace(/\s/g, "");
+  const der = Uint8Array.from(atob(pem), c => c.charCodeAt(0));
+  const key = await crypto.subtle.importKey("pkcs8", der, { name: "ECDSA", namedCurve: "P-256" }, false, ["sign"]);
+  const now = Math.floor(Date.now() / 1000);
+  const input = `${json64({ alg: "ES256", kid: env.APPLE_IAP_KEY_ID, typ: "JWT" })}.${json64({ iss: env.APPLE_IAP_ISSUER_ID, iat: now - 10, exp: now + 300, aud: "appstoreconnect-v1", bid: env.APPLE_BUNDLE_ID })}`;
+  const signature = await crypto.subtle.sign({ name: "ECDSA", hash: "SHA-256" }, key, new TextEncoder().encode(input));
+  return `${input}.${encode(new Uint8Array(signature))}`;
+}
+
+// Only decode a JWS received directly from Apple's authenticated HTTPS endpoint.
+// Never use this decoder to trust a client-supplied signed transaction.
+export function readAppleServerTransaction(signed: string): AppleTransaction {
+  const parts = signed.split(".");
+  if (parts.length !== 3 || parts[1].length > 32000) throw new ApplePurchaseError("Apple returned an invalid transaction.", 502);
+  try {
+    const raw = parts[1].replace(/-/g, "+").replace(/_/g, "/");
+    return JSON.parse(new TextDecoder().decode(Uint8Array.from(atob(raw.padEnd(Math.ceil(raw.length / 4) * 4, "=")), c => c.charCodeAt(0))));
+  } catch { throw new ApplePurchaseError("Apple returned an invalid transaction.", 502); }
+}
+
+export function validateAppleTransaction(t: AppleTransaction, expected: {
+  transactionId: string; bundleId: string; productId: string; intentId: string; createdAt: number; environment: string;
+}) {
+  if (t.transactionId !== expected.transactionId || t.bundleId !== expected.bundleId || t.productId !== expected.productId ||
+      t.appAccountToken?.toLowerCase() !== expected.intentId.toLowerCase() || t.environment !== expected.environment ||
+      t.type !== "Consumable" || t.quantity !== 1 || t.revocationDate != null ||
+      !Number.isFinite(t.purchaseDate) || t.purchaseDate < expected.createdAt - 300000 || t.purchaseDate > Date.now() + 300000 ||
+      (t.inAppOwnershipType && t.inAppOwnershipType !== "PURCHASED")) {
+    throw new ApplePurchaseError("This Apple transaction does not match the purchase.", 400);
+  }
+}
+
+export async function fetchAppleTransaction(env: EnvBindings, transactionId: string, send: typeof fetch = fetch) {
+  if (!/^\d{1,40}$/.test(transactionId)) throw new ApplePurchaseError("Invalid Apple transaction identifier.");
+  const token = await appleServerToken(env);
+  const environments = env.APPLE_ALLOW_SANDBOX_PURCHASES === "false" ? ["Production"] : ["Production", "Sandbox"];
+  for (const environment of environments) {
+    const host = environment === "Production" ? "https://api.storekit.apple.com" : "https://api.storekit-sandbox.apple.com";
+    const response = await send(`${host}/inApps/v1/transactions/${transactionId}`, {
+      headers: { Authorization: `Bearer ${token}`, Accept: "application/json" }, signal: AbortSignal.timeout(15000),
+    });
+    if (response.status === 404 && environment === "Production" && environments.length > 1) continue;
+    if (!response.ok) throw new ApplePurchaseError(response.status === 404 ? "Apple could not find this purchase yet. Please retry delivery." : "Apple purchase verification is temporarily unavailable. Please retry delivery.", response.status === 404 ? 409 : 503);
+    const body = await response.json() as { signedTransactionInfo?: string };
+    if (!body.signedTransactionInfo) throw new ApplePurchaseError("Apple returned an incomplete purchase.", 502);
+    return { transaction: readAppleServerTransaction(body.signedTransactionInfo), environment };
+  }
+  throw new ApplePurchaseError("Apple could not find this purchase yet.", 409);
+}
