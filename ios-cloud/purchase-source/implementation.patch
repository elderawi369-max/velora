+
+test("unverified, revoked or mismatched Apple transactions cannot credit an account", async () => {
+  const f = await fixture(); const intent = await f.intent(appleProducts[6].productId);
+  const original = globalThis.fetch;
+  try {
+    for (const patch of [{ productId: appleProducts[5].productId }, { appAccountToken: crypto.randomUUID() }, { revocationDate: Date.now() }]) {
+      globalThis.fetch = async () => signResponse(transaction(intent, patch));
